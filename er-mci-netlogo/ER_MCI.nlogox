    <note x="8" y="355" backgroundDark="0" fontSize="11" width="217" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Triage (the experiment variable)</note>
    <switch x="5" y="378" height="40" on="false" variable="co-triage?" width="220" display="co-triage?"></switch>
    <chooser x="5" y="423" height="60" variable="co-triage-mode" current="0" width="220" display="co-triage-mode">
