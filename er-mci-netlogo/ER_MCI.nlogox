    <slider x="1032" step="1" y="491" max="40" width="220" display="mci-threshold" height="50" min="4" direction="Horizontal" default="12.0" variable="mci-threshold" units="arrivals/30min"></slider>
    <switch x="1032" y="546" height="40" on="true" variable="proactive-command?" width="220" display="proactive-command?"></switch>
