    <note x="885" y="10" backgroundDark="0" fontSize="11" width="215" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Department</note>
    <slider x="880" step="1" y="33" max="40" width="220" display="general-beds" height="50" min="4" direction="Horizontal" default="24.0" variable="general-beds"></slider>
    <slider x="880" step="1" y="88" max="10" width="220" display="resus-beds" height="50" min="0" direction="Horizontal" default="3.0" variable="resus-beds"></slider>
    <slider x="880" step="1" y="143" max="30" width="220" display="chairs" height="50" min="0" direction="Horizontal" default="12.0" variable="chairs"></slider>
    <slider x="880" step="1" y="198" max="20" width="220" display="surge-beds" height="50" min="0" direction="Horizontal" default="10.0" variable="surge-beds"></slider>
    <slider x="880" step="1" y="253" max="15" width="220" display="n-doctors" height="50" min="1" direction="Horizontal" default="4.0" variable="n-doctors"></slider>
