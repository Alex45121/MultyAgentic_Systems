    </chooser>
    <slider x="5" step="0.5" y="488" max="10" width="220" display="triage-time" height="50" min="1" direction="Horizontal" default="4.0" variable="triage-time" units="min"></slider>
    <slider x="5" step="0.1" y="543" max="10" width="220" display="expectant-threshold" height="50" min="8" direction="Horizontal" default="9.2" variable="expectant-threshold"></slider>
    <monitor x="5" precision="0" y="604" height="60" fontSize="11" width="100" display="minute">ticks</monitor>
    <monitor x="110" precision="0" y="604" height="60" fontSize="11" width="100" display="mode">mode-label</monitor>
    <monitor x="215" precision="0" y="604" height="60" fontSize="11" width="100" display="in ED">count patients</monitor>
    <monitor x="5" precision="0" y="669" height="60" fontSize="11" width="100" display="deaths">deaths</monitor>
    <monitor x="110" precision="0" y="669" height="60" fontSize="11" width="100" display="died waiting">deaths-waiting</monitor>
    <monitor x="215" precision="0" y="669" height="60" fontSize="11" width="100" display="preventable">preventable-deaths</monitor>
    <monitor x="5" precision="0" y="734" height="60" fontSize="11" width="100" display="left unseen">lwbs</monitor>
    <monitor x="110" precision="2" y="734" height="60" fontSize="11" width="100" display="red/orange late">critical-delay-rate</monitor>
    <monitor x="215" precision="0" y="734" height="60" fontSize="11" width="100" display="p90 to triage">p90-door-to-triage</monitor>
    <monitor x="5" precision="2" y="799" height="60" fontSize="11" width="100" display="under-triage">under-triage-rate</monitor>
    <monitor x="110" precision="0" y="799" height="60" fontSize="11" width="100" display="messages">total-messages</monitor>
