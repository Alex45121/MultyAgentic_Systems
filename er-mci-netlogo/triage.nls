; =====================================================================
;  TRIAGE SETUP
; =====================================================================
to setup-triage
  create-triagers 1 [
    set agent-name "triage" set inbox [] set mci-belief? false
    set paired? (co-triage? and co-triage-mode = "paired")
    set queue []
    set expected-urgent []
    set my-desk item 0 desk-patches
    set current-patient nobody
    set remaining 0
    set retriaging? false
    set nurse2 nobody
    set last-check table:make
    set extra-nurse nobody
    set extra-desk-open-at -1
    set extra-nurse-leaving? false
    set shape "person" set color pink set size 1.2 setxy 13 13
    set the-triager self
  ]
  if co-triage? [
    create-nurses 1 [
      set agent-name "nurse-2" set inbox [] set mci-belief? false
      set shape "person" set color pink set size 1.2
      set current-patient nobody
      set remaining 0
      set retriaging? false
      ifelse co-triage-mode = "parallel" [
        set my-desk item 1 desk-patches
        setxy 13 9
      ] [
        set my-desk item 0 desk-patches
        setxy 11 13
      ]
      ask the-triager [ set nurse2 myself ]
    ]
  ]
end

; =====================================================================
;  TRIAGE AGENT
; =====================================================================
to triage-step
  foreach take-inbox [ m ->
    handle-common m
    if first m = "ARRIVED" [ set queue lput (item 1 m) queue ]
    if first m = "EXPECT_URGENT" [ set expected-urgent lput (item 1 m) expected-urgent ]
    if first m = "MCI_DECLARED" [
      if mci-extra-desk? and extra-nurse = nobody and extra-desk-open-at < 0 [
        set extra-desk-open-at ticks + extra-desk-delay
      ]
    ]
    if first m = "STAND_DOWN" [
      if extra-nurse != nobody [ set extra-nurse-leaving? true ]
      set extra-desk-open-at -1
    ]
  ]
  set queue filter [ p -> p != nobody ] queue
  own-desk-step
  if co-triage? [
    ifelse co-triage-mode = "parallel"
      [ ask nurse2 [ request-desk-step myself ] ]
      [ ask nurse2 [ mirror-desk-step myself ] ]
  ]
  if extra-nurse = nobody and extra-desk-open-at >= 0 and ticks >= extra-desk-open-at [
    open-extra-desk
  ]
  if extra-nurse != nobody [
    ask extra-nurse [ extra-desk-step myself extra-nurse-leaving? ]
    if extra-nurse-leaving? and [current-patient] of extra-nurse = nobody [
      close-extra-desk
    ]
  ]
end

; lead procedure: works her own desk directly from her own queue - unchanged
; logic from before Phase 2, just using her own fields instead of a list slot
to own-desk-step
  if current-patient != nobody [
    set remaining remaining - 1
    if remaining <= 0 [
      ifelse retriaging? [
        finish-retriage current-patient
        move-to my-desk
      ] [
        complete-triage current-patient
      ]
      set current-patient nobody
    ]
  ]
  if current-patient = nobody and not empty? queue [
    let nxt next-triage-patient
    set current-patient nxt
    set remaining triage-duration
    set retriaging? false
    let d my-desk
    ask nxt [ set stage "in-triage" set t-triage-start ticks move-to d ]
  ]
  if current-patient = nobody and empty? queue and retriage? [
    let p retriage-candidate
    if p != nobody [
      table:put last-check [pid] of p ticks
      set current-patient p
      set remaining retriage-time
      set retriaging? true
      move-to p
      set xcor xcor + 0.3
    ]
  ]
end

; nurse-2 procedure (parallel mode): a free nurse asks the lead for work -
; same pattern as doctors' REQUEST_WORK, a direct call plus a counted
; message so there is no one-tick inbox delay
to request-desk-step [ lead ]
  if current-patient != nobody [
    set remaining remaining - 1
    if remaining <= 0 [
      let p current-patient
      ifelse retriaging? [
        ask lead [ finish-retriage p ]
        move-to my-desk
      ] [
        ask lead [ complete-triage p ]
      ]
      set current-patient nobody
    ]
  ]
  if current-patient = nobody [
    count-msg "READY"
    ifelse not empty? [queue] of lead [
      let nxt [next-triage-patient] of lead
      count-msg "ASSIGN"
      set current-patient nxt
      set remaining [triage-duration] of lead
      set retriaging? false
      let d my-desk
      ask nxt [ set stage "in-triage" set t-triage-start ticks move-to d ]
    ] [
      if retriage? [
        let p [retriage-candidate] of lead
        if p != nobody [
          ask lead [ table:put last-check [pid] of p ticks ]
          set current-patient p
          set remaining retriage-time
          set retriaging? true
          move-to p
          set xcor xcor + 0.3
        ]
      ]
    ]
  ]
end

; nurse-2 procedure (paired mode): shares the lead's desk and patient instead
; of pulling her own - paired triage is one task worked by two people, so
; there is nothing separate to request
to mirror-desk-step [ lead ]
  set my-desk [my-desk] of lead
  set current-patient [current-patient] of lead
  set remaining [remaining] of lead
  set retriaging? [retriaging?] of lead
  move-to lead
  set xcor xcor + 0.3
end

; =====================================================================
;  RETRIAGE (Phase 3) - MTS requires waiting patients to be re-checked
;  periodically; only fires when there is no new arrival to triage first
; =====================================================================

; lead procedure: ticks since p was last checked (first check = original triage)
to-report last-check-of [ tbl p ]
  ifelse table:has-key? tbl [pid] of p
    [ report table:get tbl [pid] of p ]
    [ report [t-triage-end] of p ]
end

; lead procedure: the most overdue waiting-bed patient, or nobody
to-report retriage-candidate
  let tbl last-check
  let due patients with [ stage = "waiting-bed" and (ticks - last-check-of tbl self) >= retriage-interval ]
  if not any? due [ report nobody ]
  report min-one-of due [ last-check-of tbl self ]
end

; lead procedure: conclude a re-check - upgrade-only, so a noisy re-check can
; never quietly demote someone who is still critical; patient never moved
; and stayed in stage "waiting-bed" the whole time
to finish-retriage [ p ]
  let sd ifelse-value paired? [ paired-error-sd ] [ solo-error-sd ]
  if mci-belief? [ set sd sd + mci-extra-error-sd ]
  let new-est max list 0 (min list 10 ([severity] of p + random-normal 0 sd))
  if new-est > [est-severity] of p [
    ask p [ set est-severity new-est set assigned-level level-of new-est ]
    send-msg agent-name the-bed-manager "RETRIAGED" p
  ]
end

; =====================================================================
;  EXTRA MCI DESK (Phase 4) - the disaster plan puts a temporary triage
;  officer at the entrance once an MCI is declared; she is always solo
;  speed/error regardless of the main pair's co-triage-mode, and leaves
;  once stood down (after finishing whoever she is with)
; =====================================================================

to-report extra-desk-patch
  report patch 12 11
end

; lead procedure: disaster plan opens a temporary entrance triage desk
to open-extra-desk
  create-ordered-nurses 1 [
    set agent-name "nurse-extra" set inbox [] set mci-belief? false
    set shape "person" set color pink set size 1.2
    set my-desk extra-desk-patch
    set current-patient nobody
    set remaining 0
    set retriaging? false
    move-to my-desk
    ask the-triager [ set extra-nurse myself ]
  ]
  ask extra-desk-patch [ set pcolor pink - 2 ]
  set extra-desk-open-at -1
  log-event "Extra triage desk opened"
end

; lead procedure: she has just finished whoever she was with - send her home
to close-extra-desk
  ask extra-desk-patch [ set pcolor black ]
  ask extra-nurse [ die ]
  set extra-nurse nobody
  set extra-nurse-leaving? false
  log-event "Extra triage desk closed"
end

; extra-nurse procedure: same ask-the-lead-for-work pattern as nurse 2 in
; parallel mode, but stops taking new patients once stood down, and always
; uses solo speed/error - she is a temporary crisis hire, not a trained pair
to extra-desk-step [ lead leaving? ]
  if current-patient != nobody [
    set remaining remaining - 1
    if remaining <= 0 [
      let p current-patient
      ask lead [ complete-solo-triage p ]
      set current-patient nobody
    ]
  ]
  if current-patient = nobody and not leaving? [
    count-msg "READY"
    if not empty? [queue] of lead [
      let nxt [next-triage-patient] of lead
      count-msg "ASSIGN"
      set current-patient nxt
      set remaining [solo-triage-duration] of lead
      let d my-desk
      ask nxt [ set stage "in-triage" set t-triage-start ticks move-to d ]
    ]
  ]
end

; lead procedure: solo duration for the extra nurse, independent of the main
; pair's paired?/co-triage-mode, but still affected by MCI mode like everyone
to-report solo-triage-duration
  let m triage-time
  if mci-belief? [ set m m * mci-triage-factor ]
  report max list 0.5 (lognormal m 0.35)
end

; lead procedure: solo error for the extra nurse, independent of paired?
to complete-solo-triage [ p ]
  let sd solo-error-sd
  if mci-belief? [ set sd sd + mci-extra-error-sd ]
  let tri-mci mci-belief?
  ask p [
    set est-severity max list 0 (min list 10 (severity + random-normal 0 sd))
    set assigned-level level-of est-severity
    set expectant-at-triage? (tri-mci and est-severity >= expectant-threshold)
    set t-triage-end ticks
    set stage "waiting-bed"
    move-to one-of bedq-patches
  ]
  send-msg agent-name the-bed-manager "TRIAGED" p
end

; obviously critical patients and ambulance patients announced as urgent jump the queue
to-report next-triage-patient
  let eu expected-urgent
  let crit filter [ p -> [severity] of p >= visible-critical or member? ([pid] of p) eu ] queue
  let pick first queue
  if not empty? crit [ set pick first crit ]
  set queue remove pick queue
  report pick
end

to-report triage-duration
  let m triage-time
  if paired? [ set m m * paired-time-factor ]
  if mci-belief? [ set m m * mci-triage-factor ]
  report max list 0.5 (lognormal m 0.35)
end

to complete-triage [ p ]
  let sd ifelse-value paired? [ paired-error-sd ] [ solo-error-sd ]
  if mci-belief? [ set sd sd + mci-extra-error-sd ]
  let tri-mci mci-belief?
  ask p [
    set est-severity max list 0 (min list 10 (severity + random-normal 0 sd))
    set assigned-level level-of est-severity
    set expectant-at-triage? (tri-mci and est-severity >= expectant-threshold)
    set t-triage-end ticks
    set stage "waiting-bed"
    move-to one-of bedq-patches
  ]
  send-msg agent-name the-bed-manager "TRIAGED" p
end